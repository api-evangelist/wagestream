        {
          "id": "0380dc33-3dea-4b68-b085-32ba44d6476b",
          "name": "Notifies Wagestream to complete the enrollment for an employee",
          "request": {
            "name": "Notifies Wagestream to complete the enrollment for an employee",
            "description": {
              "content": "When an employee is approved for activation, and their bank details have changed in the employer's payroll system, POST to this endpoint to inform Wagestream. The employee will immediately be able to transfer any eligible wages.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "enrollments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "employee_id",
                  "value": "<string>",
                  "description": "(Required) ID of the employee to activate"
                }
              ],
              "variable": []
            },
            "method": "POST",
            "auth": null
          },
          "response": [
