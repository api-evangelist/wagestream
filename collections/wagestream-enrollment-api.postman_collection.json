        {
          "id": "d9f5ed53-2f3a-4fac-8a50-ede5048e4d85",
          "name": "Simulate the start of the enrollment process for an employee",
          "request": {
            "name": "Simulate the start of the enrollment process for an employee",
            "description": {
              "content": "Only for use when testing, not available on production. This endpoints enables you to take an employee which you've previously uploaded and trigger the start of the enrollment process for, this enables you to test the end to end process for enrollments",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "testenrollments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "employee_ids",
                  "value": "<string>",
                  "description": "(Required) Comma delimited list of employee_id's to trigger the enrollment process with"
                },
                {
                  "disabled": false,
                  "key": "employee_ids",
                  "value": "<string>",
                  "description": "(Required) Comma delimited list of employee_id's to trigger the enrollment process with"
                },
                {
                  "disabled": false,
                  "key": "pending",
                  "value": "<boolean,null>",
                  "description": "This setting is only useful if you are implementing the `Enterprise` or `Instant Verification` enrolment flows. If you are using the `Standard` Enrolment flow, then this parameter is redundant.\n\nIncluding and setting pending to `true` simulates an employee registering on the app, and them then \naccepting terms and conditions. At this stage they are in Pending\n\nAfter polling for pending enrollments, and seeing an employee requesting to enroll - you would\nsubmit, via POSTing to the employees end point the remaining information required to complete\ntheir enrolment."
                }
              ],
              "variable": []
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "541d1df3-195d-4ea9-8d32-500bbd44edee",
